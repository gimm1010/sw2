#define PIN_LED 7

int period = 100;   // 10ms > 10000, 1ms > 1000, 0.1ms > 100
int duty = 0;

void setup() {

  pinMode(PIN_LED, OUTPUT);

  digitalWrite(PIN_LED, HIGH);   // LED OFF (active LOW)

  set_period(10000);             // 10 ms
  set_duty(0);
}

void loop() {

  // 최소 밝기 -> 최대 밝기
  for (int i = 0; i <= 100; i++) {
    set_duty(i);
    pwm();
  }

  // 최대 밝기 -> 최소 밝기
  for (int i = 99; i >= 0; i--) {
    set_duty(i);
    pwm();
  }
}

void set_period(int p) {

  if (p >= 100 && p <= 10000) {
    period = p;
  }
}

void set_duty(int d) {

  if (d >= 0 && d <= 100) {
    duty = d;
  }
}

void pwm() {

  long on_time;
  long off_time;

  on_time = (long)period * duty / 100;
  off_time = period - on_time;

  digitalWrite(PIN_LED, LOW);    // LED ON
  delayMicroseconds(on_time);

  digitalWrite(PIN_LED, HIGH);   // LED OFF
  delayMicroseconds(off_time);
}
