
#include <Servo.h>

// Arduino pin assignment
#define PIN_IR    A0
#define PIN_LED   9
#define PIN_SERVO 10

// configurable parameters
#define _DUTY_MIN 500
#define _DUTY_NEU 1500
#define _DUTY_MAX 2500

#define _DIST_MIN 100.0
#define _DIST_MAX 250.0

#define EMA_ALPHA 0.5
#define LOOP_INTERVAL 50

// global variables
Servo myservo;

unsigned long last_loop_time = 0;

float dist_prev = _DIST_MIN;
float dist_ema = _DIST_MIN;

void setup()
{
  pinMode(PIN_LED, OUTPUT);
  pinMode(PIN_IR, INPUT);

  digitalWrite(PIN_LED, HIGH); // LED OFF (active LOW)

  myservo.attach(PIN_SERVO);
  myservo.writeMicroseconds(_DUTY_NEU);

  Serial.begin(57600);
}

void loop()
{
  unsigned long time_curr = millis();

  int duty;
  float a_value, dist_raw, dist_filtered;

  // wait until next event time
  if (time_curr - last_loop_time < LOOP_INTERVAL)
    return;

  last_loop_time += LOOP_INTERVAL;

  // IR sensor measurement
  a_value = analogRead(PIN_IR);

  // convert IR value to distance (mm)
  if (a_value <= 9.0) {
    dist_raw = 0.0;
  }
  else {
    dist_raw = ((6762.0 / (a_value - 9.0)) - 4.0) * 10.0;
  }

  // Range filter (100~250mm)
  if (dist_raw >= _DIST_MIN && dist_raw <= _DIST_MAX) {
    dist_filtered = dist_raw;
    dist_prev = dist_raw;

    digitalWrite(PIN_LED, LOW);  // LED ON
  }
  else {
    dist_filtered = dist_prev;

    digitalWrite(PIN_LED, HIGH); // LED OFF
  }

  // EMA filter
  dist_ema =
      EMA_ALPHA * dist_filtered
    + (1.0 - EMA_ALPHA) * dist_ema;

  // Convert distance to servo duty (without map())
  duty = (int)(
    _DUTY_MIN
    + (dist_ema - _DIST_MIN)
    * (_DUTY_MAX - _DUTY_MIN)
    / (_DIST_MAX - _DIST_MIN)
    + 0.5
  );

  duty = constrain(duty, _DUTY_MIN, _DUTY_MAX);

  // Servo control
  myservo.writeMicroseconds(duty);

  // Serial output for Serial Plotter
  Serial.print("_DUTY_MIN:");
  Serial.print(_DUTY_MIN);

  Serial.print(",_DIST_MIN:");
  Serial.print(_DIST_MIN);

  Serial.print(",IR:");
  Serial.print(a_value);

  Serial.print(",dist_raw:");
  Serial.print(dist_raw);

  Serial.print(",ema:");
  Serial.print(dist_ema);

  Serial.print(",servo:");
  Serial.print(duty);

  Serial.print(",_DIST_MAX:");
  Serial.print(_DIST_MAX);

  Serial.print(",_DUTY_MAX:");
  Serial.print(_DUTY_MAX);

  Serial.println("");
}
