
#include <Servo.h>

// Arduino pin assignment
#define PIN_LED 9
#define PIN_TRIG 12
#define PIN_ECHO 13
#define PIN_SERVO 10

// configurable parameters
#define SND_VEL 346.0
#define INTERVAL 25
#define PULSE_DURATION 10

#define _DIST_MIN 180.0   // 18cm (mm)
#define _DIST_MAX 360.0   // 36cm (mm)

#define TIMEOUT ((INTERVAL / 2) * 1000.0)
#define SCALE (0.001 * 0.5 * SND_VEL)

#define _EMA_ALPHA 0.5

// global variables
unsigned long last_sampling_time = 0;

float dist_prev = _DIST_MIN;
float dist_ema = _DIST_MIN;
bool ema_initialized = false;

Servo myservo;

void setup() {
  pinMode(PIN_LED, OUTPUT);
  pinMode(PIN_TRIG, OUTPUT);
  pinMode(PIN_ECHO, INPUT);

  digitalWrite(PIN_TRIG, LOW);
  digitalWrite(PIN_LED, HIGH);

  Serial.begin(57600);

  myservo.attach(PIN_SERVO);
  myservo.write(0);

  last_sampling_time = millis();
}

void loop() {
  float dist_raw, dist_filtered;
  int servo_angle;

  // sampling interval: 25ms
  if (millis() - last_sampling_time < INTERVAL)
    return;

  last_sampling_time += INTERVAL;

  // measure distance
  dist_raw = USS_measure(PIN_TRIG, PIN_ECHO);

  // range filter
  if (dist_raw == 0.0) {
    // measurement failed: use previous value
    dist_filtered = dist_prev;
  }
  else if (dist_raw < _DIST_MIN) {
    dist_filtered = _DIST_MIN;
  }
  else if (dist_raw > _DIST_MAX) {
    dist_filtered = _DIST_MAX;
  }
  else {
    dist_filtered = dist_raw;
  }

  if (dist_raw != 0.0) {
    dist_prev = dist_filtered;
  }

  // EMA filter
  if (!ema_initialized) {
    dist_ema = dist_filtered;
    ema_initialized = true;
  }
  else {
    dist_ema =
      _EMA_ALPHA * dist_filtered
      + (1.0 - _EMA_ALPHA) * dist_ema;
  }

  // distance to servo angle (0~180 degrees)
  servo_angle = (int)(
    (dist_ema - _DIST_MIN) * 180.0
    / (_DIST_MAX - _DIST_MIN)
    + 0.5
  );

  servo_angle = constrain(servo_angle, 0, 180);

  // control servo
  myservo.write(servo_angle);

  // LED ON when distance is within range
  if (dist_raw >= _DIST_MIN && dist_raw <= _DIST_MAX) {
    digitalWrite(PIN_LED, LOW);
  }
  else {
    digitalWrite(PIN_LED, HIGH);
  }

  // serial output
  Serial.print("Min:");
  Serial.print(_DIST_MIN);

  Serial.print(",dist:");
  Serial.print(dist_raw);

  Serial.print(",ema:");
  Serial.print(dist_ema);

  Serial.print(",Servo:");
  Serial.print(myservo.read());

  Serial.print(",Max:");
  Serial.print(_DIST_MAX);

  Serial.println("");
}

// ultrasonic distance measurement (mm)
float USS_measure(int TRIG, int ECHO) {
  digitalWrite(TRIG, HIGH);
  delayMicroseconds(PULSE_DURATION);
  digitalWrite(TRIG, LOW);

  return pulseIn(ECHO, HIGH, TIMEOUT) * SCALE;
}
